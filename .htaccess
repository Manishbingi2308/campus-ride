# CampusRide Apache Configuration
# Compatible with XAMPP and InfinityFree Shared Hosting

# Default Charset
AddDefaultCharset UTF-8

# Prevent Directory Browsing
Options -Indexes

# Protect Sensitive Files from Web Access
<FilesMatch "^(\.env|\.git|\.gitignore|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect Database Directory from Direct Browser Access
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^database/ - [F,L,NC]
</IfModule>
