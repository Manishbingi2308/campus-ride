# ========================================================
# CampusRide Environment Configuration Template
# Copy this file to `.env` in the root folder to customize
# ========================================================

# --- LOCAL XAMPP ENVIRONMENT (Default) ---
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=campus_ride_sharing
DB_USER=root
DB_PASSWORD=

# Optional: Override base URL if needed (default: auto-detected)
# APP_URL=http://localhost/campus-ride

